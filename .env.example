# ─────────────────────────────────────────────
# Copia este archivo como .env y rellena los
# valores reales antes de ejecutar el proyecto.
# NUNCA subas el archivo .env a GitHub.
# ─────────────────────────────────────────────

# Clave secreta de Flask (usa una cadena larga y aleatoria en producción)
SECRET_KEY=tu_clave_secreta_aqui

# ── Base de datos ─────────────────────────────
# URL de conexión a Supabase (PostgreSQL).
# Si está vacío, se usa SQLite local automáticamente.
DATABASE_URL=postgresql://postgres:tu_password@db.tu_proyecto.supabase.co:5432/postgres

# ── Supabase Storage ──────────────────────────
SUPABASE_URL=https://tu_proyecto.supabase.co
SUPABASE_SERVICE_KEY=tu_service_role_key_aqui

# ── OpenAI ────────────────────────────────────
OPENAI_API_KEY=sk-tu_api_key_de_openai_aqui

# ── Flask-Mail (SMTP) ─────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
MAIL_USE_TLS=False
MAIL_USE_SSL=True
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_contrasena_de_aplicacion_aqui
MAIL_DEFAULT_SENDER=tu_correo@gmail.com
